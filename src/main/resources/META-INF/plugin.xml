<idea-plugin>
    <id>io.github.mrsuttonmann.efcorepowertools</id>
    <name>Power Tools for EF Core</name>
    <vendor url="https://github.com/MrSuttonmann">Ted Hyde</vendor>
    <description><![CDATA[
<p>Reverse engineering, model visualization and inspection for EF Core in JetBrains Rider -
an unofficial port of the <a href="https://github.com/ErikEJ/EFCorePowerTools">EF Core Power Tools</a> Visual Studio
extension by Erik Ejlskov Jensen (MIT License). Source: <a href="https://github.com/MrSuttonmann/RiderEFCorePowerTools">MrSuttonmann/RiderEFCorePowerTools</a>.</p>
<ul>
  <li>Reverse engineer a DbContext and entity classes from SQL Server, Azure SQL, SQLite, PostgreSQL, MySQL, Oracle, Firebird, Snowflake or a SQL Server .dacpac / Database Project</li>
  <li>Refresh from <code>efpt.config.json</code>, edit and run <code>efcpt-config.json</code></li>
  <li>DbContext diagram (DGML), DDL SQL, DebugView and DbContext-to-database comparison</li>
  <li>Database schema diagram, Mermaid ER diagram, SQL project analysis and Data API Builder scaffolding</li>
</ul>
<p>Uses the same bundled .NET runners as the Visual Studio extension. Requires EF Core 10, projects targeting .NET 10 or later, and the .NET 10 runtime.</p>
]]></description>

    <depends>com.intellij.modules.rider</depends>
    <depends optional="true" config-file="efpt-database.xml">com.intellij.database</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.efpt.rider.settings.EfptSettings"/>
        <applicationService serviceImplementation="com.efpt.rider.connections.ConnectionStore"/>
        <applicationConfigurable parentId="tools" instance="com.efpt.rider.settings.EfptConfigurable"
                                 id="com.efpt.rider.settings" displayName="Power Tools for EF Core"/>
        <notificationGroup id="Power Tools for EF Core" displayType="BALLOON"/>
        <!-- Rider has no DGML editor; open .dgml files (DbContext / database diagrams) as XML. -->
        <fileType name="XML" extensions="dgml"/>
    </extensions>

    <actions>
        <!-- Project context menu -->
        <group id="EFCorePowerTools.ProjectGroup" class="com.efpt.rider.actions.EfptProjectGroup" popup="true"
               text="Power Tools for EF Core" icon="AllIcons.Nodes.DataTables">
            <add-to-group group-id="SolutionExplorerPopupMenu" anchor="last"/>

            <action id="EFCorePowerTools.ReverseEngineer" class="com.efpt.rider.actions.ReverseEngineerAction"
                    text="Reverse Engineer" description="Generate a DbContext and entity classes from a database"/>
            <action id="EFCorePowerTools.ReverseEngineerLegacy" class="com.efpt.rider.actions.ReverseEngineerLegacyAction"
                    text="Reverse Engineer (Legacy)" description="Reverse engineer using the separate-dialog workflow"/>
            <action id="EFCorePowerTools.ReverseEngineerRefresh" class="com.efpt.rider.actions.ReverseEngineerRefreshAction"
                    text="Refresh" description="Regenerate code from the project's efpt.config.json"/>
            <action id="EFCorePowerTools.DabBuilder" class="com.efpt.rider.actions.DabBuilderAction"
                    text="Data API Builder Scaffold (preview)" description="Create a Data API Builder configuration"/>
            <separator/>
            <action id="EFCorePowerTools.DgmlBuild" class="com.efpt.rider.actions.DgmlBuildAction"
                    text="Add DbContext Diagram" description="Create a DGML diagram of the DbContext model"/>
            <action id="EFCorePowerTools.SqlBuild" class="com.efpt.rider.actions.SqlBuildAction"
                    text="View DbContext DDL SQL" description="Show the SQL CREATE script for the DbContext model"/>
            <action id="EFCorePowerTools.DebugViewBuild" class="com.efpt.rider.actions.DebugViewBuildAction"
                    text="View DbContext as DebugView" description="Show the DbContext model DebugView"/>
            <action id="EFCorePowerTools.DgmlNuget" class="com.efpt.rider.actions.DgmlNugetAction"
                    text="Add AsDgml() extension" description="Install ErikEJ.EntityFrameworkCore.DgmlBuilder"/>
            <action id="EFCorePowerTools.DbCompare" class="com.efpt.rider.actions.DbCompareAction"
                    text="Compare DbContext to database" description="Compare the DbContext model to a database schema"/>
            <separator/>
            <action id="EFCorePowerTools.DbDgml" class="com.efpt.rider.actions.DatabaseDiagramAction"
                    text="Visualize Database Schema" description="Create a DGML diagram of a database schema"/>
            <action id="EFCorePowerTools.DbErDiagram" class="com.efpt.rider.actions.ErDiagramAction"
                    text="ER Diagram" description="Create a Mermaid ER diagram of a database"/>
            <action id="EFCorePowerTools.SqlprojAnalyze" class="com.efpt.rider.actions.SqlprojAnalyzeAction"
                    text="Analyze (preview)" description="Analyze the SQL Database Project with SQL Server rules"/>
            <separator/>
            <action id="EFCorePowerTools.Options" class="com.efpt.rider.actions.OptionsAction"
                    text="Options" description="Power Tools for EF Core options"/>
            <action id="EFCorePowerTools.About" class="com.efpt.rider.actions.AboutAction"
                    text="About" description="About Power Tools for EF Core"/>
        </group>

        <!-- SQL Database Project context menu -->
        <action id="EFCorePowerTools.SqlprojCreate" class="com.efpt.rider.actions.SqlprojCreateAction"
                text="Create EF Core DbContext..." description="Reverse engineer this database project into a C# project"
                icon="AllIcons.Nodes.DataTables">
            <add-to-group group-id="SolutionExplorerPopupMenu" anchor="last"/>
        </action>

        <!-- Config file context menu -->
        <group id="EFCorePowerTools.ConfigFileGroup">
            <add-to-group group-id="SolutionExplorerPopupMenu" anchor="last"/>
            <action id="EFCorePowerTools.ConfigEdit" class="com.efpt.rider.actions.ConfigEditAction"
                    text="Power Tools for EF Core - Edit" icon="AllIcons.Actions.Edit"/>
            <action id="EFCorePowerTools.ConfigRefresh" class="com.efpt.rider.actions.ConfigRefreshAction"
                    text="Power Tools for EF Core - Refresh" icon="AllIcons.Actions.Refresh"/>
            <action id="EFCorePowerTools.DabStart" class="com.efpt.rider.actions.DabStartAction"
                    text="Power Tools for EF Core - Start DAB" icon="AllIcons.Actions.Execute"/>
        </group>

        <!-- Tools menu -->
        <group id="EFCorePowerTools.ToolsGroup" popup="true" text="Power Tools for EF Core" icon="AllIcons.Nodes.DataTables">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <reference ref="EFCorePowerTools.ReverseEngineer"/>
            <reference ref="EFCorePowerTools.ReverseEngineerRefresh"/>
            <reference ref="EFCorePowerTools.DbDgml"/>
            <reference ref="EFCorePowerTools.DbErDiagram"/>
            <separator/>
            <reference ref="EFCorePowerTools.Options"/>
            <reference ref="EFCorePowerTools.About"/>
        </group>
    </actions>
</idea-plugin>
